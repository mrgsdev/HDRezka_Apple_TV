    "0+, 6+, 12+ или 16+. Всё, что старше, скрыто и не запускается.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "0+, 6+, 12+ or 16+. Anything older is hidden and won't play."
