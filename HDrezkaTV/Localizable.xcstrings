    "Фильмы 10 разных жанров.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Movies in 10 different genres."
          }
        }
      }
    },
    "Фильмы шести разных десятилетий.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Movies from six different decades."
          }
        }
      }
    },
    "Фильмы, сериалы, мультфильмы": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Movies, series, cartoons"
